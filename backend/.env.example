# Application
APP_NAME=Bangladesh E-Commerce ERP
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string-at-least-64-chars
API_V1_PREFIX=/api/v1
TIMEZONE=Asia/Dhaka
CURRENCY=BDT
CURRENCY_SYMBOL=৳

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=bd_ecommerce_erp

# JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=15
ADMIN_REFRESH_TOKEN_EXPIRE_DAYS=1

# 2FA
TOTP_ISSUER=BD-ERP-Admin
TOTP_DIGITS=6
TOTP_INTERVAL=30
MAX_2FA_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Bangladesh Payments (use real merchant credentials in production)
BKASH_API_KEY=
BKASH_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta

NAGAD_MERCHANT_ID=
NAGAD_API_KEY=
NAGAD_BASE_URL=

ROCKET_MERCHANT_ID=
ROCKET_API_KEY=

# Email / SMS (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMS_API_KEY=

# Redis (for Celery / caching)
REDIS_URL=redis://localhost:6379/0

# Frontend URL (for redirects / QR)
FRONTEND_URL=http://localhost:3000